---
import { sliderToValue, type Scale } from '../lib/scale';
import { formatNumberHtml } from '../lib/format';
import type { Locale } from '../lib/i18n';

/**
 * Contract: the <output id="<id>-out"> always echoes the slider's own value (for a log slider, 10 to
 * the position), formatted for `locale`. A topic wires its own `input` listener and shows its
 * computed result in an element of its own, never in this output.
 */
interface Props {
  id: string;
  label: string;
  /** For a log slider, min, max and value are exponents of ten. */
  min: number;
  max: number;
  step: number;
  scale: Scale;
  value: number;
  locale: Locale;
}

const { id, label, min, max, step, scale, value, locale } = Astro.props;
---

<div class="slider">
  <label for={id} class="hand">{label}</label>
  <input type="range" {id} {min} {max} {step} {value} data-scale={scale} />
  <output id={`${id}-out`} for={id} class="result" set:html={formatNumberHtml(sliderToValue(value, scale), locale)} />
</div>

<script>
  import '../scripts/slider';
</script>

<style>
  .slider {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    align-items: center;
    max-width: 32rem;
  }

  label {
    grid-column: 1 / -1;
    color: var(--chalk);
    font-size: 1.15rem;
  }

  input {
    width: 100%;
    min-height: 2rem;
    accent-color: var(--chalk-yellow);
    cursor: pointer;
  }

  input:focus-visible {
    outline: 2px solid var(--chalk-yellow);
    outline-offset: 4px;
    border-radius: 4px;
  }

  output {
    min-width: 5ch;
    color: var(--chalk-yellow);
    font-size: 1.4rem;
    text-align: right;
  }
</style>

---
// One beat of the story: text on the left, its figure pinned beside it while the text scrolls.
// `stack` puts a wide figure (a ruler, a long chart) under the text, at full width; on a phone it scrolls sideways.
interface Props {
  stack?: boolean;
  /** Names the stacked figure for assistive tech: on a phone it is a keyboard-focusable sideways scroller. */
  figureLabel?: string;
}

const { stack = false, figureLabel } = Astro.props;
const scroller = stack && figureLabel ? { tabindex: 0, role: 'region', 'aria-label': figureLabel } : {};
---

<section class:list={['step', { stack }]}>
  <div class="text"><slot /></div>
  <div class="figure" {...scroller}><slot name="figure" /></div>
</section>

<style>
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2rem 3rem;
    align-items: start;
    margin-block: 4rem;
  }

  .figure {
    position: sticky;
    top: 2rem;
  }

  .text :global(p) {
    max-width: 60ch;
  }

  .stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .stack .figure {
    position: static;
  }

  @media (max-width: 759px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      margin-block: 2.5rem;
    }

    .figure {
      position: static;
    }

    /* A wide figure keeps a legible size and scrolls sideways instead of shrinking. */
    .stack .figure {
      overflow-x: auto;
      /* Chalk-dust fades on the edges that still hide something. The `local` layers scroll with the
         content and cover the fixed ones, so each fade disappears once that end is reached. */
      background:
        linear-gradient(to right, var(--slate) 30%, transparent) left center / 2.5rem 100% no-repeat local,
        linear-gradient(to left, var(--slate) 30%, transparent) right center / 2.5rem 100% no-repeat local,
        linear-gradient(to right, rgba(244, 241, 232, 0.28), transparent) left center / 1.75rem 100% no-repeat scroll,
        linear-gradient(to left, rgba(244, 241, 232, 0.28), transparent) right center / 1.75rem 100% no-repeat scroll;
    }

    .stack .figure :global(.scene) {
      min-width: 40rem;
    }
  }
</style>

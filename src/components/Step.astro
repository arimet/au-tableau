---
// One beat of the story: text on the left, its figure pinned beside it while the text scrolls.
// `stack` puts a wide figure (a ruler, a long chart) under the text, at full width; on a phone it scrolls sideways.
interface Props {
  stack?: boolean;
}

const { stack = false } = Astro.props;
---

<section class:list={['step', { stack }]}>
  <div class="text"><slot /></div>
  <div class="figure"><slot name="figure" /></div>
</section>

<style>
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2rem 3rem;
    align-items: start;
    margin-block: 4rem;
  }

  .figure {
    position: sticky;
    top: 2rem;
  }

  .text :global(p) {
    max-width: 60ch;
  }

  .stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .stack .figure {
    position: static;
  }

  @media (max-width: 759px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      margin-block: 2.5rem;
    }

    .figure {
      position: static;
    }

    /* A wide figure keeps a legible size and scrolls sideways instead of shrinking. */
    .stack .figure {
      overflow-x: auto;
    }

    .stack .figure :global(.scene) {
      min-width: 40rem;
    }
  }
</style>

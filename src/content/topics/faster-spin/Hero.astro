---
// Opening scene: the Earth spins faster (24 h → 20 h); the equator warms, the poles cool, and the
// thermometer of the global mean barely moves.
import Scene from '../../../components/chalk/Scene.astro';
import Annotation from '../../../components/chalk/Annotation.astro';
import { rng, sketchCircle, sketchLine, arrowHead, hatch, smoothPath, type Pt } from '../../../lib/chalk';
import type { Locale } from '../../../lib/i18n';
import { figures } from './data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const fr = locale === 'fr';
const f = figures(locale);
const rand = rng(2027);

const [cx, cy, r] = [240, 214, 112];
// Band edges, as a fraction of the radius from the centre: tropics and polar circles.
const [TROPIC, POLAR] = [0.3, 0.66];

/** Points of an ellipse from angle a0 to a1, with a faint hand tremor. */
const ellipse = (ex: number, ey: number, rx: number, ry: number, a0: number, a1: number): Pt[] => {
  const n = Math.max(8, Math.round(Math.abs(a1 - a0) * 12));
  return Array.from({ length: n + 1 }, (_, i) => {
    const a = a0 + ((a1 - a0) * i) / n;
    return [ex + rx * Math.cos(a) + (rand() - 0.5) * 0.8, ey + ry * Math.sin(a) + (rand() - 0.5) * 0.8];
  });
};
const endAngle = (p: Pt[]) => Math.atan2(p[p.length - 1][1] - p[p.length - 2][1], p[p.length - 1][0] - p[p.length - 2][0]);
/** Near half of a parallel at height `k·r` above the centre (negative is south), seen from a little above. */
const parallel = (k: number) => {
  const rx = r * Math.sqrt(1 - k * k);
  return smoothPath(ellipse(cx, cy - k * r, rx - 1, 0.16 * rx, Math.PI, 0));
};

const outline = sketchCircle(rand, cx, cy, r);
const outline2 = sketchCircle(rand, cx, cy, r - 1.5, { wobble: 0.016, grow: -0.02 });
const warm = hatch(rand, cx, cy, r, 6, 0.62);
const cold = hatch(rand, cx, cy, r, 6, -0.62);
const lines = [parallel(0), parallel(POLAR), parallel(-POLAR)];

// Two spin arrows above the North Pole: the Earth turns faster.
const axis = sketchLine(rand, [cx, cy - r + 2], [cx, cy - r - 70], 0.6);
const spins = [44, 30].map((h, i) => {
  const pts = ellipse(cx, cy - r - h, 46 - i * 6, 12, 3.0, 0.3);
  return { d: smoothPath(pts), head: arrowHead(rand, pts[pts.length - 1], endAngle(pts), 10) };
});

// Thermometer of the global mean, on the right.
const [tx, tTop, tBottom] = [510, 150, 300];
const tube = smoothPath([[tx - 9, tBottom - 14], [tx - 9, tTop], [tx - 4, tTop - 8], [tx + 4, tTop - 8], [tx + 9, tTop], [tx + 9, tBottom - 14]]);
const bulb = sketchCircle(rand, tx, tBottom, 17, { overshoot: 0.15 });
const ticks = [0, 1, 2, 3, 4].map((i) => sketchLine(rand, [tx + 11, tTop + 18 + i * 22], [tx + 20, tTop + 18 + i * 22], 0.3));
const level = tTop + 18 + 2 * 22;
const wiggle = smoothPath([[tx - 26, level - 3], [tx - 20, level + 3], [tx - 14, level - 3]]);

const text = fr
  ? {
      label: `Schéma : la Terre tourne plus vite, un tour en ${f.hoursTarget} h au lieu de ${f.hoursNow} h. La bande de l’équateur se réchauffe, les calottes des pôles se refroidissent. Un thermomètre de la moyenne mondiale bouge à peine.`,
      spin: `un tour : ${f.hoursNow} h → ${f.hoursTarget} h`,
      warm: 'plus chaud',
      cold: 'plus froid',
      mean: ['la moyenne', 'bouge à peine'],
    }
  : {
      label: `Diagram: the Earth spins faster, one turn in ${f.hoursTarget} h instead of ${f.hoursNow} h. The band around the equator warms, the polar caps cool. A thermometer of the global mean barely moves.`,
      spin: `one turn: ${f.hoursNow} h → ${f.hoursTarget} h`,
      warm: 'warmer',
      cold: 'colder',
      mean: ['the mean', 'barely moves'],
    };
const line = (d: string, t: number, dur: number) => ({ d, style: `--t:${t}s;--d:${dur}s` });
---

<Scene viewBox="0 0 600 380" label={text.label} {locale}>
  <defs>
    <clipPath id="spin-hero-earth"><circle {cx} {cy} r={r - 1} /></clipPath>
    <clipPath id="spin-hero-tropics"><rect x="0" y={cy - TROPIC * r} width="600" height={2 * TROPIC * r} /></clipPath>
    <clipPath id="spin-hero-poles">
      <rect x="0" y="0" width="600" height={cy - POLAR * r} />
      <rect x="0" y={cy + POLAR * r} width="600" height="380" />
    </clipPath>
  </defs>

  <g clip-path="url(#spin-hero-earth)">
    <g clip-path="url(#spin-hero-tropics)" stroke="var(--pink)" stroke-width="1.6" opacity="0.75" fill="none" stroke-linecap="round">
      {warm.map((d, i) => <path class="draw" pathLength="1" {d} style={`--t:${(2.6 + i * 0.02).toFixed(2)}s;--d:.2s`} />)}
    </g>
    <g clip-path="url(#spin-hero-poles)" stroke="var(--blue)" stroke-width="1.6" opacity="0.75" fill="none" stroke-linecap="round">
      {cold.map((d, i) => <path class="draw" pathLength="1" {d} style={`--t:${(3.4 + i * 0.02).toFixed(2)}s;--d:.2s`} />)}
    </g>
  </g>

  <g fill="none" stroke="var(--chalk)" stroke-linecap="round" stroke-linejoin="round">
    <path class="draw" pathLength="1" d={outline} stroke-width="2.3" style="--d:1.1s" />
    <path class="draw" pathLength="1" d={outline2} stroke-width="1.3" opacity="0.55" style="--t:.25s;--d:1.1s" />
    {lines.map((d, i) => <path class="draw" pathLength="1" {...line(d, 1.1 + i * 0.25, 0.6)} stroke-width="1.4" opacity="0.8" />)}
    <path class="draw" pathLength="1" {...line(axis, 1.8, 0.3)} stroke-width="1.3" />
    {
      spins.map((s, i) => (
        <>
          <path class="draw" pathLength="1" {...line(s.d, 2 + i * 0.25, 0.35)} stroke-width="2.3" stroke="var(--chalk-yellow)" />
          {s.head.map((d) => <path class="draw" pathLength="1" {...line(d, 2.35 + i * 0.25, 0.12)} stroke-width="2.3" stroke="var(--chalk-yellow)" />)}
        </>
      ))
    }

    <path class="draw" pathLength="1" {...line(tube, 4.3, 0.6)} stroke-width="2" />
    <path class="draw" pathLength="1" {...line(bulb, 4.8, 0.4)} stroke-width="2" />
    {ticks.map((d, i) => <path class="draw" pathLength="1" {...line(d, 5.2 + i * 0.05, 0.1)} stroke-width="1.3" opacity="0.7" />)}
    <path class="draw" pathLength="1" {...line(wiggle, 5.9, 0.3)} stroke="var(--chalk-yellow)" stroke-width="2" />
  </g>
  <g class="pop" style="--t:5.5s" fill="var(--pink)" fill-opacity="0.7">
    <circle cx={tx} cy={tBottom} r="12" />
    <rect x={tx - 4} y={level} width="8" height={tBottom - level - 8} />
  </g>

  <g class="labels">
    <Annotation x={cx + 60} y={cy - r - 46} t={2.6}>{text.spin}</Annotation>
    <Annotation x={cx + r + 14} y={cy + 6} t={3}>{text.warm}</Annotation>
    <Annotation x={cx + 86} y={cy - r + 4} t={3.8}>{text.cold}</Annotation>
    <Annotation x={cx + 86} y={cy + r + 6} t={3.9}>{text.cold}</Annotation>
    <Annotation x={tx} y={tTop - 44} t={6.2} anchor="middle">{text.mean[0]}</Annotation>
    <Annotation x={tx} y={tTop - 20} t={6.35} anchor="middle">{text.mean[1]}</Annotation>
  </g>
</Scene>

<style>
  /* A slate halo keeps the writing legible where it crosses a line or the hatching. */
  .labels :global(text) {
    paint-order: stroke;
    stroke: var(--slate);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
</style>

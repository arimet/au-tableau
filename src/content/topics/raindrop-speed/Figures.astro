---
// Small figures for the story: speed against diameter, the drop against a fall without air,
// and the real shapes next to the cartoon teardrop.
import Scene from '../../../components/chalk/Scene.astro';
import Annotation from '../../../components/chalk/Annotation.astro';
import { rng, sketchCircle, sketchLine, arrowHead, hatch, smoothPath, type Pt } from '../../../lib/chalk';
import type { Locale } from '../../../lib/i18n';
import { figures, terminalSpeed, dropAxes, SLIDER, SIZES, FREE_SPEED } from './data';
import { sketchEllipse, teardrop } from './drop';

interface Props {
  name: 'speed' | 'freefall' | 'shape';
  locale: Locale;
}

const { name, locale } = Astro.props;
const fr = locale === 'fr';
const f = figures(locale);
const rand = rng({ speed: 41, freefall: 42, shape: 43 }[name]);
const draw = (t: number, d: number) => `--t:${t}s;--d:${d}s`;
const marks = [SIZES.SMALL_MM, SIZES.MID_MM, SIZES.BIG_MM];

// Speed: v(D) from the slider's lower end to 5 mm, 70 px per mm and 20 px per m/s.
const [X0, Y0] = [70, 236];
const xOf = (mm: number) => X0 + mm * 70;
const yOf = (v: number) => Y0 - v * 20;
const curvePts: Pt[] = [];
for (let mm = SLIDER.min; mm <= SLIDER.max + 1e-9; mm += 0.25) curvePts.push([xOf(mm), yOf(terminalSpeed(mm))]);
const curve = smoothPath(curvePts);
const xAxis = sketchLine(rand, [X0, Y0], [xOf(5.4), Y0], 1);
const yAxis = sketchLine(rand, [X0, Y0], [X0, yOf(10.4)], 1);
const xTicks = marks.map((mm) => ({ mm, d: sketchLine(rand, [xOf(mm), Y0 - 6], [xOf(mm), Y0 + 6], 0.3) }));
const yTicks = [5, 10].map((v) => ({ v, d: sketchLine(rand, [X0 - 6, yOf(v)], [X0 + 6, yOf(v)], 0.3) }));
const points = marks.map((mm) => ({ mm, x: xOf(mm), y: yOf(terminalSpeed(mm)), d: sketchCircle(rand, xOf(mm), yOf(terminalSpeed(mm)), 5, { overshoot: 0.2 }) }));
const speedText = [f.vSmall, f.vMid, f.vBig];

// Free fall: two bars to the same scale, 2.6 px per m/s.
const BX = 60, BK = 2.6;
const vBig = terminalSpeed(SIZES.BIG_MM);
const bars = [
  { y: 90, v: vBig, color: 'var(--blue)' },
  { y: 190, v: FREE_SPEED, color: 'var(--pink)' },
].map((b) => {
  const x1 = BX + b.v * BK;
  return { ...b, x1, outline: [sketchLine(rand, [BX, b.y], [x1, b.y], 0.6), sketchLine(rand, [x1, b.y], [x1, b.y + 34], 0.4), sketchLine(rand, [x1, b.y + 34], [BX, b.y + 34], 0.6)], fill: hatch(rand, (BX + x1) / 2, b.y + 17, Math.max(17, (x1 - BX) / 2), 6, 0.9) };
});
const barAxis = sketchLine(rand, [BX, 60], [BX, 250], 0.8);

// Shape: the cartoon teardrop crossed out, then three drops to scale, 20 px per mm, each with the volume of a sphere of its diameter.
const tear = teardrop(60, 150, 76);
const cross = [sketchLine(rand, [24, 92], [96, 196], 1.5), sketchLine(rand, [96, 92], [24, 196], 1.5)];
const SX = [175, 275, 400], SY = 150, SK = 20;
const shapes = marks.map((mm, i) => {
  const { a, b } = dropAxes(mm);
  const rx = a * SK, ry = b * SK;
  return { mm, rx, ry, x: SX[i], outline: sketchEllipse(rand, SX[i], SY, rx, ry), fill: hatch(rand, SX[i], SY, rx, 5, 0.9) };
});
const ratioText = [f.ratioSmall, f.ratioMid, f.ratioBig];
const flow = [sketchLine(rand, [470, 220], [470, 110], 1), ...arrowHead(rand, [470, 110], -Math.PI / 2, 10)];

const labels = {
  speed: fr
    ? { scene: `Courbe de la vitesse de chute selon le diamètre de la goutte, de ${f.sliderMin} à ${f.sliderMax} mm. Elle monte vite puis s’aplatit : ${f.vSmall} m/s à ${f.smallMm} mm, ${f.vMid} m/s à ${f.midMm} mm, ${f.vBig} m/s à ${f.bigMm} mm.`, x: 'diamètre (mm)', y: 'vitesse (m/s)' }
    : { scene: `Curve of fall speed against drop diameter, from ${f.sliderMin} to ${f.sliderMax} mm. It climbs fast, then flattens: ${f.vSmall} m/s at ${f.smallMm} mm, ${f.vMid} m/s at ${f.midMm} mm, ${f.vBig} m/s at ${f.bigMm} mm.`, x: 'diameter (mm)', y: 'speed (m/s)' },
  freefall: fr
    ? { scene: `Deux barres à la même échelle. Dans l’air, une goutte de ${f.bigMm} mm tombe à ${f.vBig} m/s. Sans air, après ${f.fallM} m de chute, elle irait à ${f.vFree} m/s, ${f.freeRatio} fois plus vite.`, a: [`dans l’air, ${f.bigMm} mm : ${f.vBig} m/s`, `sans air, après ${f.fallM} m : ${f.vFree} m/s`] }
    : { scene: `Two bars on the same scale. In air, a ${f.bigMm} mm drop falls at ${f.vBig} m/s. Without air, after a ${f.fallM} m fall, it would reach ${f.vFree} m/s, ${f.freeRatio} times faster.`, a: [`in air, ${f.bigMm} mm: ${f.vBig} m/s`, `without air, after ${f.fallM} m: ${f.vFree} m/s`] },
  shape: fr
    ? { scene: `À gauche, une larme barrée. À droite, trois gouttes vues de profil, à l’échelle : de ${f.smallMm}, ${f.midMm} et ${f.bigMm} mm. Leur hauteur vaut ${f.ratioSmall}, ${f.ratioMid} puis ${f.ratioBig} de leur largeur. L’air arrive par en dessous.`, a: 'hauteur / largeur', b: 'air' }
    : { scene: `On the left, a crossed-out teardrop. On the right, three drops seen side on, to scale: ${f.smallMm}, ${f.midMm} and ${f.bigMm} mm. Their height is ${f.ratioSmall}, ${f.ratioMid} and then ${f.ratioBig} of their width. Air comes from below.`, a: 'height / width', b: 'air' },
}[name];
const viewBox = { speed: '0 0 460 300', freefall: '0 0 460 280', shape: '0 0 520 280' }[name];
---

<Scene {viewBox} label={labels.scene} {locale}>
  {
    name === 'speed' && (
      <>
        <g fill="none" stroke="var(--chalk)" stroke-width="2" stroke-linecap="round">
          <path class="draw" pathLength="1" d={xAxis} style={draw(0, 0.6)} />
          <path class="draw" pathLength="1" d={yAxis} style={draw(0.3, 0.5)} />
          {[...xTicks, ...yTicks].map(({ d }, i) => <path class="draw" pathLength="1" {d} stroke-width="1.6" style={draw(0.6 + i * 0.06, 0.1)} />)}
        </g>
        <path class="draw" pathLength="1" d={curve} fill="none" stroke="var(--blue)" stroke-width="2.8" stroke-linecap="round" style={draw(1.2, 1.4)} />
        <g fill="none" stroke="var(--chalk-yellow)" stroke-width="2.3">
          {points.map(({ d }, i) => <path class="draw" pathLength="1" {d} style={draw(2.8 + i * 0.4, 0.25)} />)}
        </g>
        <g class="labels">
          {xTicks.map(({ mm }, i) => <Annotation x={xOf(mm)} y={Y0 + 28} t={0.7 + i * 0.06} anchor="middle">{mm}</Annotation>)}
          {yTicks.map(({ v }, i) => <Annotation x={X0 - 12} y={yOf(v) + 6} t={0.9 + i * 0.06} anchor="end">{v}</Annotation>)}
          {points.map((p, i) => <Annotation x={p.x + (i === 2 ? -4 : 10)} y={p.y + (i === 2 ? -16 : 24)} t={3 + i * 0.4} anchor={i === 2 ? 'end' : 'start'}>{`${speedText[i]} m/s`}</Annotation>)}
          <Annotation x={xOf(5.4)} y={Y0 + 56} t={0.5} anchor="end">{labels.x}</Annotation>
          <Annotation x={X0 + 10} y={yOf(10.4) + 6} t={0.5}>{labels.y}</Annotation>
        </g>
      </>
    )
  }

  {
    name === 'freefall' && (
      <>
        <defs>
          {bars.map((b, i) => (
            <clipPath id={`rain-bar-${i}`}>
              <rect x={BX + 1} y={b.y + 1} width={b.x1 - BX - 1} height="32" />
            </clipPath>
          ))}
        </defs>
        <path class="draw" pathLength="1" d={barAxis} fill="none" stroke="var(--chalk)" stroke-width="2.3" stroke-linecap="round" style={draw(0, 0.5)} />
        {bars.map((b, i) => (
          <>
            <g clip-path={`url(#rain-bar-${i})`} stroke={b.color} stroke-width="1.6" opacity="0.7" fill="none" stroke-linecap="round">
              {b.fill.map((d, j) => <path class="draw" pathLength="1" {d} style={draw(1 + i * 1.2 + j * 0.01, 0.12)} />)}
            </g>
            <g fill="none" stroke={b.color} stroke-width="2.3" stroke-linecap="round">
              {b.outline.map((d, j) => <path class="draw" pathLength="1" {d} style={draw(0.4 + i * 1.2 + j * 0.2, i ? 0.6 : 0.2)} />)}
            </g>
          </>
        ))}
        <g class="labels">
          {bars.map((b, i) => <Annotation x={BX} y={b.y - 12} t={0.6 + i * 1.2}>{labels.a[i]}</Annotation>)}
        </g>
      </>
    )
  }

  {
    name === 'shape' && (
      <>
        <defs>
          {shapes.map((s, i) => (
            <clipPath id={`rain-shape-${i}`}>
              <ellipse cx={s.x} cy={SY} rx={s.rx - 1} ry={s.ry - 1} />
            </clipPath>
          ))}
        </defs>
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path class="draw" pathLength="1" d={tear} stroke="var(--chalk)" stroke-width="2.3" opacity="0.8" style={draw(0, 0.8)} />
          <g stroke="var(--pink)" stroke-width="2.6">
            {cross.map((d, i) => <path class="draw" pathLength="1" {d} style={draw(0.9 + i * 0.3, 0.25)} />)}
          </g>
          {shapes.map((s, i) => (
            <>
              <g clip-path={`url(#rain-shape-${i})`} stroke="var(--blue)" stroke-width="1.4" opacity="0.75">
                {s.fill.map((d, j) => <path class="draw" pathLength="1" {d} style={draw(1.9 + i * 0.6 + j * 0.02, 0.1)} />)}
              </g>
              <path class="draw" pathLength="1" d={s.outline} stroke="var(--blue)" stroke-width="2.3" style={draw(1.6 + i * 0.6, 0.4)} />
            </>
          ))}
          <g stroke="var(--chalk)" stroke-width="2" opacity="0.8">
            {flow.map((d, i) => <path class="draw" pathLength="1" {d} style={draw(3.6 + (i ? 0.4 : 0), i ? 0.12 : 0.4)} />)}
          </g>
        </g>
        <g class="labels">
          {shapes.map((s, i) => (
            <>
              <Annotation x={s.x} y={SY + 70} t={1.8 + i * 0.6} anchor="middle">{`${s.mm} mm`}</Annotation>
              <Annotation x={s.x} y={SY - 58} t={2.2 + i * 0.6} anchor="middle">{ratioText[i]}</Annotation>
            </>
          ))}
          <Annotation x={275} y={50} t={2} anchor="middle">{labels.a}</Annotation>
          <Annotation x={482} y={240} t={4}>{labels.b}</Annotation>
        </g>
      </>
    )
  }
</Scene>

<style>
  .labels :global(text) {
    paint-order: stroke;
    stroke: var(--slate);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
</style>

---
// Placeholder hero: a sketched Earth. Task 8 replaces it with the real opening scene.
import Scene from '../../../components/chalk/Scene.astro';
import { rng, sketchCircle } from '../../../lib/chalk';
import type { Locale } from '../../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const earth = sketchCircle(rng(7), 150, 100, 70);
const label = locale === 'fr' ? 'La Terre, esquissée à la craie.' : 'The Earth, sketched in chalk.';
---

<Scene viewBox="0 0 300 200" label={label} locale={locale}>
  <path class="draw" pathLength="1" style="--t:0s;--d:1.2s" d={earth} fill="none" stroke="var(--blue)" stroke-width="4" stroke-linecap="round" />
</Scene>

---
// Opening scene: the Sun cut open. Light zigzags out of the core, the gas carries it through the outer
// layer, then it flies straight to the Earth. Not to scale.
import Scene from '../../../components/chalk/Scene.astro';
import Annotation from '../../../components/chalk/Annotation.astro';
import { rng, sketchCircle, sketchArc, sketchLine, arrowHead, hatch, type Pt } from '../../../lib/chalk';
import type { Locale } from '../../../lib/i18n';
import { figures } from './data';
import { randomWalk, polyline, aimAt } from './walk';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const fr = locale === 'fr';
const f = figures(locale);
const rand = rng(2027);

const sun = { x: 175, y: 190, r: 150 };
const base = sun.r * 0.713; // base of the convective zone, at its true share of the radius
const earth = { x: 545, y: 190, r: 14 };

const outline = sketchCircle(rand, sun.x, sun.y, sun.r);
const baseLine = sketchCircle(rand, sun.x, sun.y, base, { wobble: 0.008 });
const coreHatch = hatch(rand, sun.x, sun.y, 36, 6, 0.8);
// Its own seed: a walk long enough to read, turned so that it leaves towards the Earth.
const walk = aimAt(randomWalk(rng(18), [sun.x, sun.y], [sun.x, sun.y], 11, base, 0.1, 900), [sun.x, sun.y], 0);
const exit = walk[walk.length - 1];

// Convection cells: small loops in the outer layer, each turning over.
const cells = Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + ((i + 0.5) * 2 * Math.PI) / 10;
  const mid = (sun.r + base) / 2;
  const cx = sun.x + mid * Math.cos(a), cy = sun.y + mid * Math.sin(a);
  return sketchArc(rand, cx, cy, (sun.r - base) / 2 - 5, a + 0.6, a + 0.6 + 1.6 * Math.PI, 0.03);
});

// From the exit point, the gas lifts the energy to the surface, then light flies straight to the Earth.
const angle = Math.atan2(exit[1] - sun.y, exit[0] - sun.x);
const surface: Pt = [sun.x + sun.r * Math.cos(angle), sun.y + sun.r * Math.sin(angle)];
const lift = sketchLine(rand, exit, surface, 2);
const toEarth: Pt = [earth.x - earth.r - 6, earth.y];
const ray = [sketchLine(rand, [sun.x + sun.r + 4, sun.y], toEarth, 0.6), ...arrowHead(rand, toEarth, 0, 10)];
const earthOutline = sketchCircle(rand, earth.x, earth.y, earth.r);

const text = fr
  ? {
      label: `Schéma, pas à l’échelle : le Soleil en coupe. Depuis le cœur, la lumière, absorbée et réémise sans cesse, avance en zigzag pendant environ ${f.walkYears} ans jusqu’à la zone convective, qui occupe les ${f.convectiveShare} extérieurs du rayon. Le gaz y porte l’énergie jusqu’à la surface. Puis la lumière file en ligne droite vers la Terre, en ${f.fromSurface}.`,
      core: 'cœur',
      zigzag: ['zigzag de la lumière :', `environ ${f.walkYears} ans`],
      convection: 'convection',
      trip: f.fromSurface,
      earth: 'Terre',
      scale: 'pas à l’échelle',
    }
  : {
      label: `Diagram, not to scale: the Sun cut open. From the core, light, absorbed and re-emitted again and again, zigzags for about ${f.walkYears} years out to the convective zone, which fills the outer ${f.convectiveShare} of the radius. There the gas carries the energy up to the surface. Then light flies straight to the Earth, in ${f.fromSurface}.`,
      core: 'core',
      zigzag: ['zigzag of the light:', `about ${f.walkYears} years`],
      convection: 'convection',
      trip: f.fromSurface,
      earth: 'Earth',
      scale: 'not to scale',
    };
const line = (d: string, t: number, dur: number) => ({ d, style: `--t:${t}s;--d:${dur}s` });
---

<Scene viewBox="0 0 600 380" label={text.label} {locale}>
  <defs>
    <clipPath id="sun-hero-core"><circle cx={sun.x} cy={sun.y} r="35" /></clipPath>
  </defs>

  <g clip-path="url(#sun-hero-core)" stroke="var(--chalk-yellow)" stroke-width="1.6" opacity="0.7" fill="none" stroke-linecap="round">
    {coreHatch.map((d, i) => <path class="draw" pathLength="1" {d} style={`--t:${(0.9 + i * 0.03).toFixed(2)}s;--d:.2s`} />)}
  </g>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path class="draw" pathLength="1" {...line(outline, 0, 1)} stroke="var(--chalk-yellow)" stroke-width="2.4" />
    <path class="draw" pathLength="1" {...line(baseLine, 0.8, 0.8)} stroke="var(--chalk)" stroke-width="1.3" stroke-dasharray="5 7" opacity="0.7" />
    {cells.map((c, i) => <path class="draw" pathLength="1" {...line(c.d, 1.4 + i * 0.08, 0.4)} stroke="var(--pink)" stroke-width="1.6" opacity="0.85" />)}
    {
      cells.map((c, i) =>
        arrowHead(rand, c.tip, c.angle, 6).map((d) => <path class="draw" pathLength="1" {...line(d, 1.8 + i * 0.08, 0.1)} stroke="var(--pink)" stroke-width="1.6" opacity="0.85" />),
      )
    }
    <path class="draw" pathLength="1" {...line(polyline(walk), 2.4, 2.4)} stroke="var(--chalk)" stroke-width="1.5" opacity="0.95" />
    <path class="draw" pathLength="1" {...line(lift, 4.8, 0.5)} stroke="var(--pink)" stroke-width="2.2" />
    {ray.map((d, i) => <path class="draw" pathLength="1" {...line(d, i ? 5.9 : 5.3, i ? 0.1 : 0.6)} stroke="var(--chalk-yellow)" stroke-width="2" />)}
    <path class="draw" pathLength="1" {...line(earthOutline, 6, 0.4)} stroke="var(--chalk)" stroke-width="2" fill="var(--blue)" fill-opacity="0.35" />
  </g>

  <g class="labels">
    <Annotation x={sun.x - 40} y={sun.y + 6} t={1.1} anchor="end">{text.core}</Annotation>
    <Annotation x={sun.x} y={28} t={2} anchor="middle">{text.convection}</Annotation>
    <Annotation x={445} y={96} t={4.6} anchor="middle">{text.zigzag[0]}</Annotation>
    <Annotation x={445} y={122} t={4.7} anchor="middle">{text.zigzag[1]}</Annotation>
    <Annotation x={(sun.x + sun.r + earth.x) / 2} y={sun.y - 14} t={6.1} anchor="middle">{text.trip}</Annotation>
    <Annotation x={earth.x} y={earth.y + 42} t={6.3} anchor="middle">{text.earth}</Annotation>
    <Annotation x={590} y={366} t={6.5} anchor="end">{text.scale}</Annotation>
  </g>
</Scene>

<style>
  .labels :global(text) {
    paint-order: stroke;
    stroke: var(--slate);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
</style>
